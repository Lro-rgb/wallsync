* {
    background-color: transparent;
    text-color: #{{colors.on_surface.default.hex_stripped}};
    font: "Font Awesome 6 Free Solid 20";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 450px;
    background-color: transparent;
    border: 0px;
}

mainbox {
    spacing: 0px;
    padding: 40px;
    border-radius: 20px;
    border: 2px solid;
    border-color: #{{colors.primary.default.hex_stripped}};
    background-color: #{{colors.surface.default.hex_stripped}};
    children: [listview];
}

listview {
    columns: 4;
    lines: 1;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: true;
    fixed-columns: true;
    spacing: 10px;
    background-color: transparent;
}

element {
    padding: 24px 16px;
    border-radius: 12px;
    background-color: #{{colors.surface_variant.default.hex_stripped}};
    text-color: #{{colors.on_surface.default.hex_stripped}};
    cursor: pointer;
}

element-text {
    font: "Font Awesome 6 Free Solid 20";
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element selected.normal {
    background-color: #{{colors.primary.default.hex_stripped}};
    text-color: #{{colors.on_primary.default.hex_stripped}};
}
