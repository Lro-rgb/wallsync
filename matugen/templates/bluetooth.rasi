* {
    background-color: transparent;
    text-color: #{{colors.on_surface.default.hex_stripped}};
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 350px;
    background-color: transparent;
    border: 0px;
}

mainbox {
    padding: 20px;
    border-radius: 16px;
    border: 2px solid;
    border-color: #{{colors.primary.default.hex_stripped}};
    background-color: #{{colors.surface.default.hex_stripped}};
    children: [inputbar, listview];
    spacing: 10px;
}

inputbar {
    background-color: #{{colors.surface_variant.default.hex_stripped}};
    border-radius: 8px;
    padding: 8px 12px;
}

listview {
    background-color: transparent;
    lines: 6;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 10px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: #{{colors.on_surface.default.hex_stripped}};
    cursor: pointer;
}

element selected {
    background-color: #{{colors.primary.default.hex_stripped}};
    text-color: #{{colors.on_primary.default.hex_stripped}};
}
